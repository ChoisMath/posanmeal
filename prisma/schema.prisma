generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum CheckInType {
  STUDENT
  WORK
  PERSONAL
}

enum CheckInSource {
  QR
  ADMIN_MANUAL
  LOCAL_SYNC
  FACE
}

enum MealKind {
  BREAKFAST
  LUNCH
  DINNER
}

enum Gender {
  MALE
  FEMALE
}

enum AdminLevel {
  NONE
  SUBADMIN
  ADMIN
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  name       String
  role       Role
  grade      Int?
  classNum   Int?
  number     Int?
  subject    String?
  homeroom   String?
  position   String?
  photoUrl   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  adminLevel AdminLevel @default(NONE)
  gender     Gender?

  checkIns      CheckIn[]
  registrations MealRegistration[]
  faceProfile   FaceProfile?

  @@index([role, grade, classNum, number])
  @@index([role, adminLevel])
}

model MealApplication {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  status    String   @default("OPEN") // "OPEN" | "CLOSED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applyStartAt DateTime?
  applyEndAt   DateTime?
  startYear    Int?
  startMonth   Int?
  monthCount   Int?

  registrations MealRegistration[]
  meals         MealApplicationMeal[]
  mealDates     MealApplicationMealDate[]

  @@index([status])
}

model MealApplicationMeal {
  applicationId       Int
  mealKind            MealKind
  price               Int      @default(0)
  exemptionSelectable Boolean  @default(false)
  method              String   @default("NONE") // "NONE" | "YN" | "WEEKDAY" | "DATE"

  application MealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, mealKind])
}

model MealApplicationMealDate {
  applicationId Int
  mealKind      MealKind
  grade         Int
  date          DateTime @db.Date

  application MealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, mealKind, grade, date])
  @@index([date, mealKind])
}

model MealRegistration {
  id            Int       @id @default(autoincrement())
  applicationId Int
  userId        Int
  signature     String    @db.Text
  status        String    @default("APPROVED") // "APPROVED" | "CANCELLED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledAt   DateTime?
  cancelledBy   String? // "STUDENT" | "ADMIN"
  addedBy       String? // null = 학생 본인, "ADMIN" = 관리자 추가

  application MealApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals       MealRegistrationMeal[]
  mealDates   MealRegistrationMealDate[]

  @@unique([applicationId, userId])
  @@index([userId])
  @@index([applicationId, status])
}

model MealRegistrationMeal {
  registrationId  Int
  mealKind        MealKind
  applied         Boolean  @default(false)
  exempt          Boolean  @default(false)
  weekdaysByMonth String? // JSON: {"2026-07":[1,3,5]} (0=일 ~ 6=토)

  registration MealRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([registrationId, mealKind])
}

model MealRegistrationMealDate {
  registrationId Int
  mealKind       MealKind
  date           DateTime @db.Date

  registration MealRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([registrationId, mealKind, date])
  @@index([date, mealKind])
}

model CheckIn {
  id        Int            @id @default(autoincrement())
  userId    Int
  date      DateTime       @db.Date
  mealKind  MealKind
  checkedAt DateTime       @default(now())
  type      CheckInType
  source    CheckInSource?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealKind])
  @@index([date])
  @@index([userId])
  @@index([date, mealKind])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FaceProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddings     Json
  modelVersion   String
  consentAt      DateTime
  consentVersion String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
