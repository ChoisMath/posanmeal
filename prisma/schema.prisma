generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum CheckInType {
  STUDENT
  WORK
  PERSONAL
}

enum CheckInSource {
  QR
  ADMIN_MANUAL
  LOCAL_SYNC
  FACE
}

enum MealKind {
  BREAKFAST
  LUNCH
  DINNER
}

enum Gender {
  MALE
  FEMALE
}

enum AdminLevel {
  NONE
  SUBADMIN
  ADMIN
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  name       String
  role       Role
  grade      Int?
  classNum   Int?
  number     Int?
  subject    String?
  homeroom   String?
  position   String?
  photoUrl   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  adminLevel AdminLevel @default(NONE)
  gender     Gender?

  emailKey       String? @unique
  accessState    String  @default("ACTIVE")
  sessionVersion Int     @default(0)
  profileVersion Int     @default(0)

  checkIns        CheckIn[]
  registrations   MealRegistration[]
  faceProfile     FaceProfile?
  academicRecords UserAcademicRecord[]
  rosterEntries   RosterEntry[]
  rosterDecisions RosterDecision[]
  accessEvents    UserAccessEvent[]

  @@index([role, grade, classNum, number])
  @@index([role, adminLevel])
}

model MealApplication {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  status    String   @default("OPEN") // "OPEN" | "CLOSED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applyStartAt DateTime?
  applyEndAt   DateTime?
  startYear    Int?
  startMonth   Int?
  monthCount   Int?
  academicYear Int?

  year AcademicYear? @relation(fields: [academicYear], references: [year], onDelete: Restrict)

  registrations MealRegistration[]
  meals         MealApplicationMeal[]
  mealDates     MealApplicationMealDate[]

  @@index([status])
}

model MealApplicationMeal {
  applicationId       Int
  mealKind            MealKind
  price               Int      @default(0)
  exemptionSelectable Boolean  @default(false)
  method              String   @default("NONE") // "NONE" | "YN" | "WEEKDAY" | "DATE"

  application MealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, mealKind])
}

model MealApplicationMealDate {
  applicationId Int
  mealKind      MealKind
  grade         Int
  date          DateTime @db.Date

  application MealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, mealKind, grade, date])
  @@index([date, mealKind])
}

model MealRegistration {
  id            Int       @id @default(autoincrement())
  applicationId Int
  userId        Int
  signature     String    @db.Text
  status        String    @default("APPROVED") // "APPROVED" | "CANCELLED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledAt   DateTime?
  cancelledBy   String? // "STUDENT" | "ADMIN"
  addedBy       String? // null = 학생 본인, "ADMIN" = 관리자 추가

  application MealApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals       MealRegistrationMeal[]
  mealDates   MealRegistrationMealDate[]

  @@unique([applicationId, userId])
  @@index([userId])
  @@index([applicationId, status])
}

model MealRegistrationMeal {
  registrationId  Int
  mealKind        MealKind
  applied         Boolean  @default(false)
  exempt          Boolean  @default(false)
  weekdaysByMonth String? // JSON: {"2026-07":[1,3,5]} (0=일 ~ 6=토)

  registration MealRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([registrationId, mealKind])
}

model MealRegistrationMealDate {
  registrationId Int
  mealKind       MealKind
  date           DateTime @db.Date

  registration MealRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([registrationId, mealKind, date])
  @@index([date, mealKind])
}

model CheckIn {
  id        Int            @id @default(autoincrement())
  userId    Int
  date      DateTime       @db.Date
  mealKind  MealKind
  checkedAt DateTime       @default(now())
  type      CheckInType
  source    CheckInSource?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealKind])
  @@index([date])
  @@index([userId])
  @@index([date, mealKind])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FaceProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddings     Json
  modelVersion   String
  consentAt      DateTime
  consentVersion String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// 학년도 명부 (academic year roster)
// 문자열 상태 컬럼의 허용 값은 마이그레이션의 SQL CHECK가 단일 근거다.
// ---------------------------------------------------------------------------

model AcademicYear {
  year                  Int       @id
  state                 String
  version               Int       @default(0)
  reviewedVersion       Int?
  reviewedSourceVersion Int?
  activatedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  records      UserAcademicRecord[]
  entries      RosterEntry[]
  files        RosterFile[]
  imports      RosterImport[]
  decisions    RosterDecision[]
  applications MealApplication[]
  snapshots    KioskSnapshot[]
}

model RosterControl {
  id      Int    @id
  mode    String @default("PREPARING")
  version Int    @default(0)
}

model UserAcademicRecord {
  id          Int      @id @default(autoincrement())
  year        Int
  userId      Int
  role        Role
  name        String
  grade       Int?
  classNum    Int?
  number      Int?
  gender      Gender?
  subject     String?
  homeroom    String?
  position    String?
  memberState String
  needsReview Boolean  @default(false)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [year], references: [year])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([year, userId])
}

model RosterEntry {
  id              String  @id @default(cuid())
  year            Int
  userId          Int?
  emailKey        String
  draftEmail      String?
  draftProfile    Json?
  included        Boolean @default(true)
  baseUserVersion Int?
  version         Int     @default(0)

  academicYear AcademicYear @relation(fields: [year], references: [year])
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([year, emailKey])
  @@unique([year, userId])
}

model RosterFile {
  id            String   @id @default(cuid())
  year          Int
  version       Int
  schemaVersion Int
  manifest      Json
  createdAt     DateTime @default(now())

  academicYear AcademicYear @relation(fields: [year], references: [year])

  @@index([createdAt])
}

model RosterImport {
  id             String   @id @default(cuid())
  year           Int
  scope          String
  controlVersion Int
  yearVersion    Int
  payload        Json?
  preview        Json?
  summary        Json?
  state          String
  createdAt      DateTime @default(now())

  academicYear AcademicYear @relation(fields: [year], references: [year])
}

model RosterDecision {
  year          Int
  userId        Int
  decision      String
  sourceVersion Int

  academicYear AcademicYear @relation(fields: [year], references: [year])
  user         User         @relation(fields: [userId], references: [id])

  @@id([year, userId])
}

model RosterMutation {
  requestId   String   @id
  actorUserId Int? // 메인 관리자는 null. 감사 기록이므로 FK를 두지 않는다.
  kind        String
  payloadHash String
  result      Json // MutationSummary — 건수·ID만
  version     Int
  changed     Int
  createdAt   DateTime @default(now())
}

model UserAccessEvent {
  id          Int      @id @default(autoincrement())
  userId      Int
  state       String
  reason      String
  effectiveAt DateTime
  requestId   String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, effectiveAt])
}

model EligibilityEvent {
  id            Int      @id @default(autoincrement())
  scope         String
  applicationId Int? // 논리 참조: 원본이 정리돼도 시점 증거를 남긴다
  userId        Int? // 논리 참조
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  requestId     String?

  @@index([userId, occurredAt])
  @@index([applicationId, occurredAt])
}

model AcademicBackfill {
  key            String    @id
  state          String
  sourceManifest Json
  completedAt    DateTime?
  verifiedAt     DateTime?
}

model KioskSnapshot {
  id                     String   @id @default(cuid())
  version                Int
  activeYear             Int
  lastEligibilityEventId Int
  payload                Json
  issuedAt               DateTime
  freshUntil             DateTime
  coversUntil            String

  academicYear AcademicYear @relation(fields: [activeYear], references: [year])

  @@index([issuedAt])
}

model LocalCheckInReview {
  id          String    @id @default(cuid())
  clientKey   String    @unique
  payloadHash String
  payload     Json?
  snapshotId  String? // 논리 참조: 스냅샷이 정리돼도 검토 증거를 남긴다
  reason      String
  state       String    @default("PENDING")
  decision    Json?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}
